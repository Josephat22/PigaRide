<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.BodaBodaApp">
        <activity android:name=".AboutActivity" />
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".LoginActivity" android:exported="false" />
        <activity android:name=".RegisterActivity" android:exported="false" />

        <activity android:name=".passenger.PassengerDashboardActivity" android:exported="false" />
        <activity android:name=".passenger.RideRequestActivity" android:exported="false" />
        <activity android:name=".passenger.TripHistoryActivity" android:exported="false" />

        <activity android:name=".rider.RiderDashboardActivity" android:exported="false" />
        <activity android:name=".rider.RiderTripHistoryActivity" android:exported="false" />

        <activity android:name=".admin.AdminDashboardActivity" android:exported="false" />
        <activity android:name=".admin.ManageRidersActivity" android:exported="false" />

    </application>

</manifest>